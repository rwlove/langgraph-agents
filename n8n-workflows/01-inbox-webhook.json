{
  "name": "langgraph-agents \u2014 inbox webhook",
  "active": false,
  "nodes": [
    {
      "id": "11111111-1111-4111-8111-111111111101",
      "name": "Inbox Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "lg-inbox-relay",
      "parameters": {
        "httpMethod": "POST",
        "path": "lg-inbox-relay",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "11111111-1111-4111-8111-111111111102",
      "name": "Build InboxRequest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "task_id",
              "value": "={{ $json.body.task_id || $randomUUID }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "source",
              "value": "={{ $json.body.source || 'text' }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "content",
              "value": "={{ $json.body.content }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "user",
              "value": "={{ $json.body.user || 'rob' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "11111111-1111-4111-8111-111111111103",
      "name": "POST /inbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://langgraph-agents.ai.svc.cluster.local:8765/inbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task_id: $json.task_id, source: $json.source, content: $json.content, user: $json.user }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "11111111-1111-4111-8111-111111111104",
      "name": "Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ task_id: $('Build InboxRequest').first().json.task_id, status: $json.status || 'accepted' }) }}",
        "options": {
          "responseCode": 202
        }
      }
    }
  ],
  "connections": {
    "Inbox Webhook": {
      "main": [
        [
          {
            "node": "Build InboxRequest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build InboxRequest": {
      "main": [
        [
          {
            "node": "POST /inbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /inbox": {
      "main": [
        [
          {
            "node": "Respond 202",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "id": "LgInboxWebhook01"
}