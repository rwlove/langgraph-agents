{
  "name": "langgraph-agents — approval request (out → Zulip + Pushover)",
  "active": false,
  "nodes": [
    {
      "id": "22222222-2222-4222-8222-222222222201",
      "name": "Approval Request Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "lg-approval-request",
      "parameters": {
        "httpMethod": "POST",
        "path": "lg-approval-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "notes": "Called by errand-runner / approval subgraph when a workflow interrupts pending user approval. Payload: { task_id, agent, action_class, server, method, proposed_payload, summary, tier_hint, stream, topic }."
    },
    {
      "id": "22222222-2222-4222-8222-222222222202",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "task_id", "value": "={{ $json.body.task_id }}", "type": "string" },
            { "id": "n2", "name": "agent", "value": "={{ $json.body.agent }}", "type": "string" },
            { "id": "n3", "name": "action_class", "value": "={{ $json.body.action_class }}", "type": "string" },
            { "id": "n4", "name": "server", "value": "={{ $json.body.server }}", "type": "string" },
            { "id": "n5", "name": "method", "value": "={{ $json.body.method }}", "type": "string" },
            { "id": "n6", "name": "summary", "value": "={{ $json.body.summary }}", "type": "string" },
            { "id": "n7", "name": "tier_hint", "value": "={{ $json.body.tier_hint || 'notable' }}", "type": "string" },
            { "id": "n8", "name": "stream", "value": "={{ $json.body.stream || 'other' }}", "type": "string" },
            { "id": "n9", "name": "topic", "value": "={{ $json.body.topic || ('approval-' + $json.body.task_id.slice(0,8)) }}", "type": "string" },
            { "id": "na", "name": "zulip_message", "value": "={{ '**Approval needed**\\n\\nAgent: ' + $json.body.agent + '\\nAction: `' + $json.body.server + '.' + $json.body.method + '` (class ' + $json.body.action_class + ')\\n\\n' + $json.body.summary + '\\n\\nReact 👍 approve / 👎 reject / ⏸ defer' }}", "type": "string" }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "22222222-2222-4222-8222-222222222203",
      "name": "Post to Zulip",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200],
      "parameters": {
        "method": "POST",
        "url": "http://zulip.collab.svc.cluster.local/api/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "type", "value": "stream" },
            { "name": "to", "value": "={{ $json.stream }}" },
            { "name": "topic", "value": "={{ $json.topic }}" },
            { "name": "content", "value": "={{ $json.zulip_message }}" }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": { "response": { "neverError": true } }
        }
      },
      "notes": "Credential `Zulip - approval-broker bot` (httpBasicAuth: bot_email / api_key)."
    },
    {
      "id": "22222222-2222-4222-8222-222222222204",
      "name": "Tier 1?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 420],
      "parameters": {
        "conditions": {
          "options": { "version": 2, "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.tier_hint }}",
              "rightValue": "action_required",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "22222222-2222-4222-8222-222222222205",
      "name": "Pushover Tier 1",
      "type": "n8n-nodes-base.pushover",
      "typeVersion": 1,
      "position": [900, 420],
      "parameters": {
        "userKey": "={{ $env.PUSHOVER_USER_KEY }}",
        "title": "={{ '🔒 ' + $json.agent + ' — approval needed' }}",
        "message": "={{ $json.summary.slice(0, 800) + '\\n\\nReact in #' + $json.stream + ' > ' + $json.topic }}",
        "priority": 2,
        "additionalFields": {
          "retry": 60,
          "expire": 3600,
          "sound": "siren"
        }
      },
      "notes": "Credential `Pushover - langgraph-agents` (App token from 1Password langgraph-agents/PUSHOVER_APP_TOKEN). User key set via PUSHOVER_USER_KEY env."
    },
    {
      "id": "22222222-2222-4222-8222-222222222206",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ task_id: $('Normalize Payload').first().json.task_id, status: 'notified', stream: $('Normalize Payload').first().json.stream, topic: $('Normalize Payload').first().json.topic }) }}",
        "options": { "responseCode": 200 }
      }
    }
  ],
  "connections": {
    "Approval Request Webhook": {
      "main": [[{ "node": "Normalize Payload", "type": "main", "index": 0 }]]
    },
    "Normalize Payload": {
      "main": [[
        { "node": "Post to Zulip", "type": "main", "index": 0 },
        { "node": "Tier 1?", "type": "main", "index": 0 }
      ]]
    },
    "Post to Zulip": {
      "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]]
    },
    "Tier 1?": {
      "main": [
        [{ "node": "Pushover Tier 1", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
